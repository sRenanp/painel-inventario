# Copie para .env e ajuste. O .env NÃO deve ir para o git (tem senha).

# exemplo | csv | mysql
PAINEL_FONTE=exemplo

# Usado quando PAINEL_FONTE=csv
PAINEL_CSV=C:\temp\memorias.csv

# Usado quando PAINEL_FONTE=mysql (use um usuário só com SELECT no ocsweb)
OCS_DB_HOST=ocs.empresa.local
OCS_DB_PORT=3306
OCS_DB_NAME=ocsweb
OCS_DB_USER=painel_leitura
OCS_DB_PASS=

